# Copy this file to .env and fill in real values. .env is gitignored;
# this file is the tracked template documenting what's available.

# database
DB_HOST=db
DB_PORT=3306
DB_NAME=oppia
DB_USER=oppia
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

DJANGO_PORT=8000

# how often oppia-cron.sh re-runs oppiacron/update_summaries, in seconds
CRON_INTERVAL_SECONDS=3600


#oppia settings
OPPIA_ANDROID_DEFAULT_PACKAGEID=org.digitalcampus.mobile.learning
OPPIA_ANDROID_PACKAGEID=org.digitalcampus.mobile.learning

TIME_ZONE=UTC
SERVER_EMAIL=admin@example.org

DEBUG=False

SECRET_KEY=CHANGE_ME_GENERATE_A_UNIQUE_SECRET_KEY

OPPIA_GOOGLE_ANALYTICS_ENABLED=False
OPPIA_GOOGLE_ANALYTICS_CODE=YOUR_GOOGLE_ANALYTICS_CODE
OPPIA_GOOGLE_ANALYTICS_DOMAIN=YOUR_DOMAIN

OPPIA_MAX_UPLOAD_SIZE=5242880

OPPIA_ANDROID_ON_GOOGLE_PLAY=True
OPPIA_ALLOW_SELF_REGISTRATION=True
OPPIA_ALLOW_PROFILE_EDITING=True
OPPIA_SHOW_GRAVATARS=True
OPPIA_POINTS_ENABLED=True
OPPIA_BADGES_ENABLED=True
BADGE_AWARDING_METHOD=all_activities

# site / domain settings - keep these three in sync when changing domains.
# BASESITE_URL scheme: Caddy auto-upgrades to HTTPS (via its own local CA)
# for localhost too, not just real public domains, so this should be https://
# even for local dev.
DOMAIN=localhost
ALLOWED_HOSTS=localhost,127.0.0.1
BASESITE_URL=https://localhost

# initial admin user - only created if it doesn't already exist
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.org
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME
